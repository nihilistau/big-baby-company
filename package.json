{
  "name": "bbc-big-baby-company",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "node tools/balance-sim.mjs --runs 2000",
    "art:check": "node tools/gen-art.mjs --check",
