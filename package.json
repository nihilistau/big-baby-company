    "probe": "node tools/ch11-probe.mjs && node tools/meter-probe.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
